{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@orderflow/db": ["../../packages/db/src"],
      "@orderflow/ai": ["../../packages/ai/src"],
      "@orderflow/payments": ["../../packages/payments/src"],
      "@orderflow/messaging": ["../../packages/messaging/src"],
      "@orderflow/types": ["../../packages/types/src"],
      "@orderflow/config": ["../../packages/config/src"]
    }
  },
  "include": ["src/**/*", "api/**/*"],
  "exclude": ["node_modules", "dist"]
}
