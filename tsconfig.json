{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@orderflow/db": ["packages/db/src"],
      "@orderflow/ai": ["packages/ai/src"],
      "@orderflow/payments": ["packages/payments/src"],
      "@orderflow/messaging": ["packages/messaging/src"],
      "@orderflow/config": ["packages/config/src"],
      "@orderflow/types": ["packages/types/src"],
      "@orderflow/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
