{
  "name": "orderflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "build": "npm run build --workspaces",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && npm run build",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run test --workspaces",
    "db:generate": "cd packages/db && npx prisma generate",
    "db:push": "cd packages/db && npx prisma db push",
    "db:migrate": "cd packages/db && npx prisma migrate dev",
    "db:seed": "cd packages/db && npx tsx src/seed.ts",
    "db:studio": "cd packages/db && npx prisma studio",
    "typecheck": "tsc --noEmit",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "vercel:build": "cd apps/web && npm run build"
  },
  "devDependencies": {
    "@next/swc-darwin-x64": "^16.3.2",
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.102.0",
    "caniuse-lite": "^1.0.30001809",
    "svix": "^2.0.0"
  }
}
